# Contentful → Settings → API keys (Content Delivery API – access token, tylko odczyt)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Opcjonalnie:
# CONTENTFUL_ENVIRONMENT=master
# CONTENT_TYPE_ID — domyślnie blogPost (ID typu „Blog Post” w Contentful)
# CONTENTFUL_CONTENT_TYPE_ID=blogPost
# SITE_URL=https://snopek-koparka.pl

# Google Business Profile (sync opinii do data/google-reviews.json)
# OAuth client (Google Cloud) + refresh token użytkownika będącego właścicielem wizytówki
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
#
# Lokalizacja wizytówki (jedna z opcji):
# GBP_LOCATION_NAME=accounts/123456789/locations/987654321
# albo:
# GBP_ACCOUNT_ID=123456789
# GBP_LOCATION_ID=987654321
#
# Opcjonalnie (dokładna średnia i całkowita liczba opinii przez Places API):
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACE_ID=
